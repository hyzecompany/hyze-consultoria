---
import Button from "@hyze/ui/components/Button.astro";
import BaseLayout from "@hyze/ui/layouts/BaseLayout.astro";
---

<BaseLayout title="Página não encontrada" description="A página que você procura não existe.">
  <section class="mx-auto flex max-w-3xl flex-col items-start gap-6 px-4 py-32 md:px-6">
    <p class="text-8xl font-semibold">404</p>
    <p class="text-xl font-extralight text-navy-400">Essa página não existe (ou mudou de lugar).</p>
    <Button href="/">Voltar ao início</Button>
  </section>
</BaseLayout>
